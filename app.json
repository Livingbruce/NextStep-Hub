{
  "expo": {
    "name": "NextStep Hub",
    "slug": "NSMentorship",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/logoimage.jpg",
    "scheme": "nextstephub",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#090D16",
        "foregroundImage": "./assets/images/download.png",
        "backgroundImage": "./assets/images/iconlogo-removebg.png",
        "monochromeImage": "./assets/images/monochrome-removebg.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.living_bruce.NSMentorship"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/logoimage.jpg"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-blank.png",
          "imageWidth": 1,
          "resizeMode": "contain",
          "backgroundColor": "#090D16"
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-secure-store",
      "expo-image",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "color": "#16A34A"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "97c4eaf1-5622-45b1-859d-9f558a50ef07"
      }
    }
  }
}
