{
  "expo": {
    "name": "NextStep Hub",
    "slug": "NSMentorship",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/logoimage-removebg.png",
    "scheme": "nextstephub",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Camera is used for video counseling sessions.",
        "NSMicrophoneUsageDescription": "Microphone is used for counseling sessions.",
        "UIBackgroundModes": ["audio"]
      }
    },
    "android": {
      "permissions": [
        "SYSTEM_ALERT_WINDOW",
        "USE_FULL_SCREEN_INTENT",
        "POST_NOTIFICATIONS",
        "WAKE_LOCK",
        "REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#090D16",
        "foregroundImage": "./assets/images/download.png",
        "backgroundImage": "./assets/images/iconlogo-removebg.png",
        "monochromeImage": "./assets/images/monochrome-removebg.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.living_bruce.NSMentorship"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/logoimage-removebg.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logoimage-removebg.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#090D16"
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-secure-store",
      "expo-image",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "color": "#16A34A"
        }
      ],
      "./plugin/withShowWhenLocked.js"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "97c4eaf1-5622-45b1-859d-9f558a50ef07"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/97c4eaf1-5622-45b1-859d-9f558a50ef07"
    }
  }
}
